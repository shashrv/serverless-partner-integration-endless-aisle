{
  "name": "infrastructure",
  "version": "0.2.0",
  "bin": {
    "infrastructure": "bin/infrastructure.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "package": "npm install && cd lib/lambda && npm run package && cd ../../ && npm run build && cdk synth InfrastructureStack",
    "clean": "rm -rf node_modules cdk.out lib/lambda/node_modules && find bin lib test -name '*.js' -o -name '*.d.ts' | xargs rm -f",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "aws-cdk": "2.1148.0",
    "cdk-nag": "3.0.2",
    "eslint": "10.14.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1165.0",
    "@aws-sdk/client-secrets-manager": "3.1165.0",
    "@aws-sdk/client-ses": "3.1165.0",
    "@aws-sdk/lib-dynamodb": "3.1165.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@aws-solutions-constructs/aws-cognito-apigateway-lambda": "2.106.0",
    "@aws-solutions-constructs/aws-dynamodbstreams-lambda": "2.106.0",
    "@aws-solutions-constructs/aws-lambda-dynamodb": "2.106.0",
    "@aws-solutions-constructs/aws-wafwebacl-apigateway": "2.106.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "@cdklabs/deploy-time-build": "0.1.16",
    "source-map-support": "0.5.21"
  },
  "overrides": {
    "minimatch": "11.0.5",
    "glob": "14.0.4"
  }
}
